<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Port Scanner Report — {{ generated }}</title>
<style>
  :root { --bg:#f6f8fa; --card:#fff; --border:#d0d7de; --text:#1f2328;
          --muted:#57606a; --critical:#cf222e; --high:#dc143c;
          --medium:#bf8700; --low:#0969da; --open:#1a7f37; }
  * { box-sizing: border-box; }
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
         background: var(--bg); color: var(--text); margin: 0; padding: 2rem; }
  header { background:#0d1117; color:#e6edf3; padding:1.5rem 2rem;
           border-radius:8px; margin-bottom:1.5rem; }
  header h1 { margin:0 0 .5rem 0; font-size: 1.5rem; }
  header .meta { color:#7d8590; font-size:.9rem; }
  .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
           gap:1rem; margin-bottom:2rem; }
  .card { background:var(--card); border:1px solid var(--border);
          border-radius:8px; padding:1rem; text-align:center; }
  .card .num { font-size:2rem; font-weight:700; color:var(--text); }
  .card .lbl { color:var(--muted); font-size:.75rem; text-transform:uppercase;
               letter-spacing:.05em; }
  section.host { background:var(--card); border:1px solid var(--border);
                 border-radius:8px; padding:1.25rem 1.5rem; margin-bottom:1.5rem; }
  section.host h2 { margin:0 0 .75rem 0; }
  table { width:100%; border-collapse:collapse; font-size:.9rem; }
  th,td { text-align:left; padding:.5rem .7rem; border-bottom:1px solid var(--border);
          vertical-align:top; }
  th { background:#f6f8fa; font-weight:600; }
  .state-open { color:var(--open); font-weight:700; }
  .state-closed { color:var(--muted); }
  .state-filtered { color:var(--medium); }
  .state-openfiltered { color:var(--medium); }
  .hint { color:var(--critical); font-size:.85rem; }
  footer { text-align:center; color:var(--muted); font-size:.85rem;
           margin-top:2rem; }
</style>
</head>
<body>
<header>
  <h1>Port Scanner Report</h1>
  <div class="meta">
    Generated {{ generated }} · Scan type: {{ result.scan_type.value }} ·
    Duration: {{ duration }}s · Command: <code>{{ result.command_line }}</code>
  </div>
</header>

<div class="cards">
  <div class="card"><div class="num">{{ result.targets|length }}</div>
    <div class="lbl">Hosts Scanned</div></div>
  <div class="card"><div class="num">{{ result.total_ports_scanned }}</div>
    <div class="lbl">Ports Probed</div></div>
  <div class="card"><div class="num">{{ result.open_ports_found }}</div>
    <div class="lbl">Open Ports</div></div>
  <div class="card"><div class="num">{{ duration }}s</div>
    <div class="lbl">Duration</div></div>
</div>

{% for host in result.targets %}
<section class="host">
  <h2>{{ host.ip }}{% if host.hostname %} ({{ host.hostname }}){% endif %}</h2>
  {% set open_ports = host.ports | selectattr('state.value', 'equalto', 'open') | list %}
  {% if open_ports %}
  <table>
    <thead>
      <tr><th>Port</th><th>Proto</th><th>State</th><th>Service</th>
          <th>Version</th><th>Hints</th></tr>
    </thead>
    <tbody>
      {% for p in host.ports %}
      {% if p.state.value in ('open', 'open|filtered') %}
      <tr>
        <td>{{ p.port }}</td>
        <td>{{ p.protocol }}</td>
        <td class="state-{{ p.state.value | replace('|', '') }}">{{ p.state.value }}</td>
        <td>{{ p.service or '—' }}</td>
        <td>{{ p.version or '—' }}</td>
        <td class="hint">
          {% for h in p.vuln_hints %}• {{ h }}<br>{% endfor %}
        </td>
      </tr>
      {% endif %}
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p style="color:var(--muted);">No open ports detected.</p>
  {% endif %}
</section>
{% endfor %}

<footer>
  Generated by PortScanner v1.0.0 · For authorized security testing only.
</footer>
</body>
</html>
